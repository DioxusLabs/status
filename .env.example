# Every credential below is also read from a DIOXUS_STATUS_-prefixed name
# (e.g. DIOXUS_STATUS_DEVIN_API_KEY), matching the org-level Devin secrets.

# GitHub token with read access to the DioxusLabs org (public repos is enough)
GITHUB_TOKEN=

# GitHub App auth (preferred over GITHUB_TOKEN when the app is installed).
# Provide the PEM either inline (literal \n allowed) or via path.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional: skip installation discovery (otherwise /app/installations is searched for the org)
GITHUB_APP_INSTALLATION_ID=

# Shared secret for admin mutations via /settings login
ADMIN_TOKEN=

# Devin API (v3, org-scoped)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai

# Optional: Anthropic (later phases)
ANTHROPIC_API_KEY=

# SQLite data directory
DATA_DIR=./_data

# Port (also settable by dx serve --port)
PORT=8080

# Daily cap on LLM assessment calls
LLM_DAILY_BUDGET=50
